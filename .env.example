# Copiază în .env și completează. Nu pune .env pe GitHub.

# Generează cu: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Atenție: dacă îl schimbi, parolele SMTP salvate nu mai pot fi decriptate.
SECRET_KEY=

# Parola bazei de date (generează la fel ca SECRET_KEY)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://santa:PAROLA_DE_MAI_SUS@127.0.0.1:5432/santa

# 1 = mod debug, doar local. Niciodată cu ngrok sau pe un server.
FLASK_DEBUG=0

# Adresa publică a aplicației (pentru linkurile din emailuri), ex. https://santa.exemplu.ro
# PUBLIC_URL=
# 1 dacă aplicația stă în spatele unui tunel/proxy, ca limitele să vadă IP-ul real al vizitatorilor
# BEHIND_PROXY=0
